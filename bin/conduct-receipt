#!/usr/bin/env bash
# Emitir un recibo de ejecución de gate a .conduct/receipts.jsonl
#
# POR QUE EXISTE
# Medido sobre 25 sesiones JSONL de Claude Code: 462 resultados de Bash, CERO con
# exit code registrado. El transcript de un agente NO guarda si el gate paso. Todo
# diseno que empiece parseando el transcript para saber "paso o no paso" esta
# silenciosamente roto y falla en ABIERTO.
#
# El remedio no es parsear mejor: es que el gate escriba su propio recibo. Una
# linea JSON por invocacion, con el exit code REAL, el sha del arbol y el hash de
# la salida. Eso convierte "los tests pasan" de afirmacion en algo comprobable
# contra un fichero.
#
# USO
#   conduct-receipt.sh run <tool> -- <comando...>     # ejecuta y deja recibo
#   conduct-receipt.sh last <tool>                    # ultimo recibo de esa tool
#   conduct-receipt.sh verify <tool>                  # 0 si el ultimo es verde Y
#                                                     # mas nuevo que la ultima
#                                                     # edicion de fuente
#
# El exit code del comando envuelto se PROPAGA intacto. Un emisor de recibos que
# se come el codigo de salida seria justo el fallo que documenta.
#
# Exit: el del comando envuelto (run) · 0/1 (verify) · 2 error de uso.
set -uo pipefail

RECEIPTS_DIR="${CONDUCT_DIR:-.conduct}"
RECEIPTS="$RECEIPTS_DIR/receipts.jsonl"

json_escape() {
  # Sin jq: puede no estar, y un emisor de recibos que depende de una herramienta
  # ausente no emite nada el dia que importa.
  python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))' 2>/dev/null \
    || printf '""'
}

cmd_run() {
  local tool="$1"; shift
  [[ "${1:-}" == "--" ]] && shift
  (( $# )) || { echo "uso: $0 run <tool> -- <comando...>" >&2; return 2; }

  mkdir -p "$RECEIPTS_DIR"
  local out start end dur code sha
  # python3, no `date`: el `date` de BSD (macOS) no entiende %3N y, en vez de
  # fallar, imprime "17890527803N" con exit 0 — asi que un `|| fallback` nunca
  # dispara y la aritmetica revienta mas abajo con "value too great for base".
  # Un comando que "tiene exito" devolviendo basura es peor que uno que falla.
  start=$(python3 -c 'import time; print(int(time.time()*1000))')

  # La salida se captura Y se muestra: un recibo que se traga la salida convierte
  # el gate en una caja negra para quien lo esta mirando correr.
  out=$(mktemp)
  "$@" 2>&1 | tee "$out"
  code=${PIPESTATUS[0]}

  end=$(python3 -c 'import time; print(int(time.time()*1000))')
  dur=$(( end - start ))
  sha=$(git rev-parse HEAD 2>/dev/null || echo "no-git")

  python3 - "$tool" "$code" "$dur" "$sha" "$out" "$RECEIPTS" "$@" <<'PY'
import hashlib, json, os, pathlib, sys, time
tool, code, dur, sha, outfile, receipts, *argv = sys.argv[1:]
text = pathlib.Path(outfile).read_text(encoding="utf-8", errors="replace")
row = {
    "ts": int(time.time() * 1000),
    "tool": tool,
    "argv": argv,
    "exit_code": int(code),
    "duration_ms": int(dur),
    "stdout_sha256": hashlib.sha256(text.encode("utf-8", "replace")).hexdigest(),
    # La cola, no todo: un recibo tiene que caber en un fichero que se lee.
    "stdout_tail": text[-2000:],
    "cwd": os.getcwd(),
    "git_sha": sha,
}
with open(receipts, "a", encoding="utf-8") as fh:
    fh.write(json.dumps(row, ensure_ascii=False) + "\n")
PY

  rm -f "$out"
  return "$code"
}

cmd_last() {
  local tool="${1:-}"
  [[ -f "$RECEIPTS" ]] || { echo "sin recibos en $RECEIPTS" >&2; return 2; }
  python3 - "$RECEIPTS" "$tool" <<'PY'
import json, sys
path, tool = sys.argv[1], sys.argv[2]
rows = [json.loads(l) for l in open(path, encoding="utf-8") if l.strip()]
if tool:
    rows = [r for r in rows if r.get("tool") == tool]
if not rows:
    print(f"sin recibos para {tool!r}", file=sys.stderr); raise SystemExit(2)
r = rows[-1]
print(json.dumps({k: v for k, v in r.items() if k != "stdout_tail"}, indent=2))
PY
}

cmd_verify() {
  local tool="${1:-}"
  [[ -n "$tool" ]] || { echo "uso: $0 verify <tool>" >&2; return 2; }
  [[ -f "$RECEIPTS" ]] || { echo "sin recibos: no hay nada que respalde un verde" >&2; return 1; }

  python3 - "$RECEIPTS" "$tool" <<'PY'
import json, pathlib, subprocess, sys, time
path, tool = sys.argv[1], sys.argv[2]
rows = [json.loads(l) for l in open(path, encoding="utf-8") if l.strip()]
rows = [r for r in rows if r.get("tool") == tool]
if not rows:
    print(f"sin recibo para {tool!r}: un verde sin recibo es una afirmacion, no un hecho")
    raise SystemExit(1)
r = rows[-1]
if r["exit_code"] != 0:
    print(f"el ultimo recibo de {tool!r} salio con exit {r['exit_code']}")
    raise SystemExit(1)

# La parte que de verdad importa: el recibo tiene que ser MAS NUEVO que la ultima
# edicion de fuente. Un verde de hace tres commits no dice nada del codigo de hoy.
# Es aritmetica de timestamps, no juicio.
try:
    files = subprocess.run(["git", "ls-files"], capture_output=True, text=True,
                           check=True).stdout.split()
except Exception as exc:
    print(f"no se pudo listar el arbol: {exc}"); raise SystemExit(2)

newest, newest_f = 0.0, ""
for f in files:
    p = pathlib.Path(f)
    if not p.is_file() or p.suffix in (".md", ".txt", ".jsonl", ".lock"):
        continue
    m = p.stat().st_mtime
    if m > newest:
        newest, newest_f = m, f

if newest * 1000 > r["ts"]:
    age = (newest * 1000 - r["ts"]) / 1000
    print(f"el recibo de {tool!r} es {age:.0f}s MAS VIEJO que la ultima edicion "
          f"({newest_f}) — ese verde no habla del codigo actual")
    raise SystemExit(1)

print(f"{tool}: exit 0, y el recibo es posterior a la ultima edicion de fuente")
PY
}

main() {
  case "${1:-}" in
    run)    shift; cmd_run "$@" ;;
    last)   shift; cmd_last "$@" ;;
    verify) shift; cmd_verify "$@" ;;
    *) echo "uso: $0 {run <tool> -- <cmd...> | last <tool> | verify <tool>}" >&2; return 2 ;;
  esac
}

main "$@"
